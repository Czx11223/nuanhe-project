<Slide style={{ width: '1280px', height: '720px', background: '#FBF7F1', padding: '20px 64px' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, height: 100, borderBottom: '2px solid #E4D8C8' }}>
    <Box style={{ width: 6, height: 48, background: '#B07A4F', borderRadius: 3 }} />
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2A211A' }}>d）项目效果截图</Text>
      <Text style={{ fontSize: 18, color: '#8A7B6B', marginTop: 4 }}>前台官网 / 后台工作台 / 后台内容管理（实机运行截图）</Text>
    </Box>
    <Text style={{ marginLeft: 'auto', fontSize: 16, color: '#B0A18F', letterSpacing: 2 }}>RESULTS</Text>
  </Box>

  <Box style={{ flexDirection: 'row', gap: 22, marginTop: 24, height: 326 }}>
    {[
      { img: 'assets/result_front_home.png', url: '127.0.0.1:5173', tag: '前台', title: '官网首页', sub: '品牌主视觉 · 数据成绩 · 产品与新闻入口' },
      { img: 'assets/result_admin_dashboard.png', url: '127.0.0.1:5174', tag: '后台', title: '数据工作台', sub: '内容总览与待处理留言一目了然' },
      { img: 'assets/result_admin_products.png', url: '127.0.0.1:5174', tag: '后台', title: '内容管理', sub: '产品 / 新闻 / 案例全流程增删改查' },
    ].map((it, i) => (
      <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderRadius: 14, border: '1px solid #E4D8C8', overflow: 'hidden', boxShadow: '0 4px 16px rgba(42,33,26,0.07)', flexDirection: 'column' }}>
        <Box style={{ height: 30, background: '#F2ECE4', flexDirection: 'row', alignItems: 'center', gap: 6, padding: '0 12px' }}>
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#E06C5A' }} />
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#E8B84B' }} />
          <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#7FB069' }} />
          <Box style={{ flex: 1, height: 16, borderRadius: 8, background: '#FFFFFF', justifyContent: 'center', padding: '0 10px', marginLeft: 6 }}>
            <Text style={{ fontSize: 10, color: '#9A8B79' }}>{it.url}</Text>
          </Box>
        </Box>
        <Image src={it.img} style={{ width: '100%', height: 226, objectFit: 'cover' }} />
        <Box style={{ padding: '12px 15px', flexDirection: 'column', gap: 3 }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ padding: '1px 8px', borderRadius: 5, background: '#B07A4F' }}>
              <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>{it.tag}</Text>
            </Box>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2A211A' }}>{it.title}</Text>
          </Box>
          <Text style={{ fontSize: 13, color: '#8A7B6B', lineHeight: 1.35 }}>{it.sub}</Text>
        </Box>
      </Box>
    ))}
  </Box>

  <Box style={{ flexDirection: 'row', gap: 20, marginTop: 22, height: 158, background: '#FFFFFF', borderRadius: 14, border: '1px solid #E4D8C8', padding: '20px 28px' }}>
    {[
      { icon: 'check-circle', t: '三端贯通', d: '前台、后台、API 同源同库，改一处三端同步' },
      { icon: 'cog', t: '全站可管', d: '11 个后台模块覆盖轮播、产品、案例到留言' },
      { icon: 'users', t: '多角色权限', d: '管理员 / 编辑 / 运营三级角色，双重鉴权' },
    ].map((it, i) => (
      <Box key={i} style={{ flex: 1, flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
        <Box style={{ width: 42, height: 42, borderRadius: 12, background: 'rgba(176,122,79,0.12)', justifyContent: 'center', alignItems: 'center', flexShrink: 0 }}>
          <FAIcon name={it.icon} style={{ fill: '#B07A4F', width: 22, height: 22 }} />
        </Box>
        <Box style={{ flexDirection: 'column' }}>
          <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#2A211A' }}>{it.t}</Text>
          <Text style={{ fontSize: 12.5, color: '#8A7B6B', lineHeight: 1.5, marginTop: 4 }}>{it.d}</Text>
        </Box>
      </Box>
    ))}
  </Box>

  <Box style={{ position: 'absolute', bottom: 20, left: 64, right: 64, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#9A8B79' }}>暖禾家具 · 项目成果展示</Text>
    <Text style={{ fontSize: 14, color: '#9A8B79' }}>06 / 08</Text>
  </Box>
</Slide>
