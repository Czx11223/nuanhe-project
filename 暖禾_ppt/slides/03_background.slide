<Slide style={{ width: '1280px', height: '720px', background: '#FBF7F1', padding: '20px 64px' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, height: 100, borderBottom: '2px solid #E4D8C8' }}>
    <Box style={{ width: 6, height: 48, background: '#B07A4F', borderRadius: 3 }} />
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2A211A' }}>a）项目背景</Text>
      <Text style={{ fontSize: 18, color: '#8A7B6B', marginTop: 4 }}>为何要启动 暖禾家具企业官网</Text>
    </Box>
    <Text style={{ marginLeft: 'auto', fontSize: 16, color: '#B0A18F', letterSpacing: 2 }}>BACKGROUND</Text>
  </Box>

  <Box style={{ flexDirection: 'row', gap: 40, marginTop: 22, height: 518 }}>
    <Box style={{ width: '62%', flexDirection: 'column', justifyContent: 'center', gap: 20 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2A211A', lineHeight: 1.5 }}>暖禾家具：集研发、制造、销售于一体的家居企业</Text>
      <Text style={{ fontSize: 19, color: '#5A4F45', lineHeight: 1.7 }}>
        为提升品牌形象、承接招聘与品牌展示，企业亟需一套「前台企业官网 + 后台管理系统」。前台用于品牌展示、产品与案例发布、新闻与招聘信息呈现、客户留言预约；后台供运营人员高效维护全部内容，并支持多角色分级权限。
      </Text>
      <Text style={{ fontSize: 19, color: '#5A4F45', lineHeight: 1.7 }}>
        本项目以 PRD、UIUX、数据库设计、开发技术、实施方案五份文档为基线，最终落地为「前台官网 + 后台管理 + 后端服务」三位一体的全栈交付物。
      </Text>
      <Box style={{ flexDirection: 'row', gap: 16, marginTop: 4 }}>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, padding: '16px 18px', borderLeft: '4px solid #C76B3A' }}>
          <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#C76B3A' }}>5</Text>
          <Text style={{ fontSize: 15, color: '#8A7B6B', marginTop: 2 }}>前台主导航栏目</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, padding: '16px 18px', borderLeft: '4px solid #C76B3A' }}>
          <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#C76B3A' }}>11</Text>
          <Text style={{ fontSize: 15, color: '#8A7B6B', marginTop: 2 }}>后台管理模块</Text>
        </Box>
        <Box style={{ flex: 1, background: '#FFFFFF', borderRadius: 12, padding: '16px 18px', borderLeft: '4px solid #C76B3A' }}>
          <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#C76B3A' }}>3</Text>
          <Text style={{ fontSize: 15, color: '#8A7B6B', marginTop: 2 }}>目录解耦工程</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ width: '38%', flexDirection: 'column', gap: 14, justifyContent: 'center' }}>
      <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#2A211A', marginBottom: 2 }}>旧方式的三类痛点</Text>
      {[
        { t: '展示单一', d: '缺乏统一官网，品牌形象分散' },
        { t: '后台低效', d: '内容维护依赖开发，响应慢' },
        { t: '无统一入口', d: '招聘、留言、预约分散难沉淀' },
      ].map((it, i) => (
        <Box key={i} style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start', background: '#FFFFFF', borderRadius: 12, padding: '14px 16px', boxShadow: '0 2px 10px rgba(42,33,26,0.05)' }}>
          <Box style={{ width: 38, height: 38, borderRadius: 10, background: '#2A211A', justifyContent: 'center', alignItems: 'center', flexShrink: 0 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#FFFFFF' }}>{i + 1}</Text>
          </Box>
          <Box>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#2A211A' }}>{it.t}</Text>
            <Text style={{ fontSize: 14, color: '#8A7B6B', marginTop: 2 }}>{it.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 20, left: 64, right: 64, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#9A8B79' }}>暖禾家具 · 项目成果展示</Text>
    <Text style={{ fontSize: 14, color: '#9A8B79' }}>03 / 08</Text>
  </Box>
</Slide>
