<Slide style={{ width: '1280px', height: '720px', background: '#FBF7F1', padding: '20px 64px' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, height: 100, borderBottom: '2px solid #E4D8C8' }}>
    <Box style={{ width: 6, height: 48, background: '#B07A4F', borderRadius: 3 }} />
    <Box>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#2A211A' }}>c）WordBuddy 需求处理截图</Text>
      <Text style={{ fontSize: 18, color: '#8A7B6B', marginTop: 4 }}>需求沟通 / 任务拆解 / 代码生成（请在此粘贴截图）</Text>
    </Box>
    <Text style={{ marginLeft: 'auto', fontSize: 16, color: '#B0A18F', letterSpacing: 2 }}>PROCESS</Text>
  </Box>

  <Box style={{ flexDirection: 'row', gap: 32, marginTop: 28, height: 472, justifyContent: 'center' }}>
    {[
      { tag: '截图 1', hint: '在此粘贴：与 WordBuddy 的需求沟通 / 任务拆解对话截图', sub: '建议展示需求澄清、方案拆分等关键节点' },
      { tag: '截图 2', hint: '在此粘贴：WordBuddy 代码生成 / 工程脚手架落地截图', sub: '建议展示核心模块或接口自动生成结果' },
    ].map((it, i) => (
      <Box key={i} style={{ flex: 1, borderRadius: 16, border: '3px dashed #B07A4F', background: 'rgba(176,122,79,0.06)', padding: 28, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 16 }}>
        <Box style={{ width: 70, height: 70, borderRadius: 18, background: '#FFFFFF', border: '2px dashed #B07A4F', justifyContent: 'center', alignItems: 'center' }}>
          <FAIcon name='image' style={{ fill: '#B07A4F', width: 34, height: 34 }} />
        </Box>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#2A211A' }}>{it.tag}</Text>
        <Text style={{ fontSize: 17, color: '#5A4F45', textAlign: 'center', lineHeight: 1.6 }}>{it.hint}</Text>
        <Text style={{ fontSize: 15, color: '#9A8B79', textAlign: 'center', lineHeight: 1.5 }}>{it.sub}</Text>
      </Box>
    ))}
  </Box>

  <Box style={{ position: 'absolute', bottom: 20, left: 64, right: 64, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#9A8B79' }}>暖禾家具 · 项目成果展示</Text>
    <Text style={{ fontSize: 14, color: '#9A8B79' }}>05 / 08</Text>
  </Box>
</Slide>
