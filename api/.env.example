# 复制为 api/.env 后填写。.env 已被 .gitignore 排除，切勿提交。
# 生成密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"

# 必填：缺失或仍为示例值时后端拒绝启动
JWT_SECRET=

# 初始管理员口令；留空则启动时随机生成并打印一次（首次登录强制改密）
ADMIN_INIT_PASSWORD=

# 令牌有效期（分钟）
JWT_EXPIRE_MINUTES=120

# SQLite 路径，默认 api/app.db
# DB_PATH=

# 上传目录，默认 api/static/uploads
# UPLOAD_DIR=

# 逗号分隔的跨域白名单；本地开发覆盖 3000/3001/5173/5174
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173,http://127.0.0.1:5174

# AI 助手（只配置在服务端，禁止改成 VITE_ 前缀或写入前端）
# 当前接入：阿里云百炼（千问 AI 平台）OpenAI 兼容端点 + DeepSeek 模型。
# 留空时其他业务正常启动，AI 接口返回 503。
# Key 在百炼控制台「API-KEY 管理」创建（请用个人 API Key，非应用 Key）。
AI_API_KEY=
# 若控制台给出带业务空间 ID 的专属地址（如 https://xxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1），
# 直接填该地址即可，代码会自动补 /chat/completions。
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼模型广场的 DeepSeek 模型 ID：
#   deepseek-v4-pro          旗舰，质量最好（默认）
#   deepseek-v4-flash-0731   速度与成本更优，客服问答推荐
#   deepseek-v4.1-flash      支持图片输入
AI_MODEL=deepseek-v4-pro
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1200
# 推理类模型（deepseek-r1）会自动忽略该参数
AI_TEMPERATURE=0.7
# 思考模式：留空=按模型自动（V4 默认关闭，客服场景更快更省）；true/false 强制指定
AI_ENABLE_THINKING=
