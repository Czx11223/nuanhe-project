# 统一换行符，避免跨平台协作时 Shell 脚本被转成 CRLF（容器内会报 bad interpreter）
*.sh        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       text eol=lf
*.pptx      binary
*.db        binary
*.woff      binary
*.woff2     binary
